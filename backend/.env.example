# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mplads_guardian
POSTGRES_USER=mplads
POSTGRES_PASSWORD=change_me_in_production

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production
NEO4J_DATABASE=neo4j

# ── Embedding / RAG ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VECTOR_DIMENSION=1024
USE_GPU=false

RAG_TOP_K=10
RERANK_TOP_K=3
BM25_TOP_K=10

# ── OCR ───────────────────────────────────────────────────────────────────────
# Options: PADDLE_OCR | TESSERACT
OCR_ENGINE=PADDLE_OCR
OCR_FALLBACK_THRESHOLD=0.5
TESSERACT_LANG=eng

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_DEFAULT_VERSION=2.0
POLICY_CONFIG_DIR=configs/policies

# ── Storage ───────────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=data/documents
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Entity Resolution ─────────────────────────────────────────────────────────
FUZZY_MATCH_THRESHOLD=0.85

# ── Caching ───────────────────────────────────────────────────────────────────
ENABLE_EMBEDDING_CACHE=true
ENABLE_RAG_CACHE=true
CACHE_TTL_SECONDS=3600
